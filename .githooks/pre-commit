#!/bin/sh
# Kompilerar main.typ till main.pdf och lägger till PDF:en i committen.
# Avbryter committen om kompileringen misslyckas.

if ! command -v typst >/dev/null 2>&1; then
  echo "pre-commit: typst saknas i PATH" >&2
  exit 1
fi

typst compile main.typ main.pdf || {
  echo "pre-commit: kompileringen misslyckades, committen avbryts" >&2
  exit 1
}

git add main.pdf
